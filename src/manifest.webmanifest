{
  "name": "Lannorama",
  "short_name": "Lannorama",
  "description": "Equipment Checkout & Inventory Manager",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1a0a0c",
  "theme_color": "#c6011f",
